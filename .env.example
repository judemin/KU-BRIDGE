# Copy to .env.local only when your Firebase project exists.
# These web-app identifiers are public client configuration, not administrator secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# false for a real project. true is accepted only by a local development build
# with the demo-ku-bridge project ID; it never falls through to live services.
VITE_FIREBASE_USE_EMULATORS=false
