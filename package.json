{
  "name": "ku-bridge-v3-parity-reconstruction",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-firebase-config.mjs production && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check": "npm run test",
    "test:rules": "node scripts/test-firestore.mjs",
    "test:auth": "node scripts/test-firestore.mjs --auth",
    "firebase:check": "node scripts/check-firebase-config.mjs",
    "firebase:deploy-rules": "node scripts/deploy-firestore.mjs",
    "emulators": "node scripts/test-firestore.mjs --start"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.36.0",
    "jsdom": "^26.1.0",
    "vite": "^6.4.6"
  }
}
